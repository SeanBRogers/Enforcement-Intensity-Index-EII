fiscal_pressure_z       -1.081 (p=0.000)    -1.485 (p=0.000)
trend_z                 -0.340 (p=0.240)    -0.879 (p=0.001)
regime_z                 0.353 (p=0.109)     0.601 (p=0.002)
gdp_pc_log_z            -0.669 (p=0.000)    -0.557 (p=0.000)

> # ==============================================================================
> # DEGRADATION AUDIT — UCDP/PRIO REBUILD AND THE ORIGINAL COLUMN
> # ==============================================================================
> # BACKGROUND
> # `degradation` is defined as 1 if an armed conflict is located in the state
> # that year (UCDP/PRIO Armed Conflict Dataset v25.1, gwno_loc, intensity 1 or
> # 2, any type). The column in the original panel build did not reproduce from
> # that source: it coded 102 conflict country-years as 0 (Afghanistan 26 and
> # Pakistan 23 of them; the rest across eleven other states). On 2026-10-17 the column was rebuilt from
> # UCDP; every changed cell, with its original value, is in panel_corrections.csv.
> #
> # WHAT THIS SCRIPT DOES
> #   1. Rebuilds degradation from UCDP/PRIO ACD v25.1.
> #   2. Checks that the panel's current column equals the rebuild on every
> #      codable row (1945 and 2025 are outside ACD v25.1; Hong Kong has no
> #      GW code).
> #   3. Reconstructs the ORIGINAL column from panel_corrections.csv and reports
> #      where it disagreed with UCDP.
> #   4. Refits the primary frequentist ZINB (validate.R specification) with the
> #      original and the rebuilt column, to show which results depended on it.
> #   5. Reconstructs the full pre-audit panel by reverting every logged cell
> #      and fits it (N = 535), so the pre-audit estimates can be read from
> #      this log.
> #
> # INPUT
> #   EII_Panel_Definitive.csv, panel_corrections.csv
> #   UCDP/PRIO ACD v25.1, downloaded from ucdp.uu.se if not already present
> #   (set UCDP_CSV to a local copy of UcdpPrioConflict_v25_1.csv to skip it).
> # OUTPUT
> #   degradation_audit.csv  (iso3, year, degradation_original, degradation, degradation_ucdp)
> # ==============================================================================
> 
> .libPaths(c("C:/R/library", .libPaths()))
> suppressPackageStartupMessages({
+   library(tidyverse)
+   library(pscl)
+   library(here)
+ })
> 
> UCDP_CSV <- Sys.getenv("UCDP_CSV", unset = "")
> if (UCDP_CSV == "" || !file.exists(UCDP_CSV)) {
+   zip <- tempfile(fileext = ".zip")
+   download.file("https://ucdp.uu.se/downloads/ucdpprio/ucdp-prio-acd-251-csv.zip",
+                 zip, mode = "wb")
+   dir <- tempfile(); unzip(zip, exdir = dir)
+   UCDP_CSV <- list.files(dir, pattern = "\\.csv$", full.names = TRUE)[1]
+ }
trying URL 'https://ucdp.uu.se/downloads/ucdpprio/ucdp-prio-acd-251-csv.zip'
Content type 'application/x-zip-compressed' length 43893 bytes (42 KB)
==================================================
downloaded 42 KB

> acd <- read_csv(UCDP_CSV, show_col_types = FALSE)
> stopifnot(unique(acd$version) == "25.1")
> 
> # Gleditsch-Ward codes for the panel's states (UCDP uses GW, e.g. Yemen = 678).
> # Hong Kong has no GW code. Rhodesia and Zimbabwe share 552; Vietnam is
> # North Vietnam (816) throughout, matching UCDP's continuation of 816 after 1975.
> gw <- c(AFG = 700, AGO = 540, BLR = 370, BIH = 346, BDI = 516, KHM = 811,
+         CAF = 482, CHN = 710, CIV = 437, CUB = 40, COD = 490, ERI = 531,
+         ETH = 530, DDR = 265, HTI = 41, HKG = NA, IRN = 630, IRQ = 645,
+         LAO = 812, LBN = 660, LBR = 450, LBY = 620, MLI = 432, MMR = 775,
+         NIC = 93, NIC_2 = 93, NER = 436, PRK = 731, PAK = 770, PAN = 95,
+         RHO = 552, RUS = 365, SLE = 451, SOM = 520, ZAF = 560, SSD = 626,
+         SDN = 625, SYR = 652, UGA = 500, VEN = 101, VNM = 816, YEM = 678,
+         SRB = 345, ZWE = 552)
> 
> loc <- acd |>
+   select(year, gwno_loc) |>
+   mutate(gwno = str_split(as.character(gwno_loc), ",\\s*")) |>
+   unnest(gwno) |>
+   mutate(gwno = as.integer(gwno)) |>
+   distinct(year, gwno) |>
+   mutate(conflict = 1L)
> 
> df <- read_csv(here("EII_Panel_Definitive.csv"), show_col_types = FALSE)
> stopifnot(all(df$iso3 %in% names(gw)))
> 
> # Original column = current column with logged degradation changes reverted
> corr <- read_csv(here("panel_corrections.csv"), show_col_types = FALSE,
+                  col_types = cols(.default = col_character())) |>
+   filter(variable == "degradation") |>
+   transmute(iso3, year = as.integer(year), degradation_original = as.integer(as.numeric(old)))
> 
> aud <- df |>
+   mutate(gwno = unname(gw[iso3])) |>
+   left_join(loc, by = c("year", "gwno")) |>
+   mutate(degradation_ucdp = case_when(
+     year > max(acd$year) | year < min(acd$year) | is.na(gwno) ~ NA_integer_,
+     TRUE ~ coalesce(conflict, 0L))) |>
+   left_join(corr, by = c("iso3", "year")) |>
+   mutate(degradation_original = coalesce(degradation_original, as.integer(degradation)))
> 
> cat("UCDP/PRIO ACD", unique(acd$version), "| years", min(acd$year), "-", max(acd$year), "\n")
UCDP/PRIO ACD 25.1 | years 1946 - 2024 
> 
> # ---- 2. Current column vs rebuild ----
> cod <- aud |> filter(!is.na(degradation_ucdp))
> stopifnot(all(is.na(aud$degradation) == is.na(aud$degradation_ucdp)))
> cat(sprintf("Current column equals UCDP rebuild on %d of %d codable rows\n",
+             sum(cod$degradation == cod$degradation_ucdp), nrow(cod)))
Current column equals UCDP rebuild on 908 of 908 codable rows
> stopifnot(all(cod$degradation == cod$degradation_ucdp))
> 
> # ---- 3. Original column vs UCDP ----
> cat(sprintf("Original column agreed with UCDP on %.1f%% of %d codable rows\n",
+             100 * mean(cod$degradation_original == cod$degradation_ucdp), nrow(cod)))
Original column agreed with UCDP on 88.8% of 908 codable rows
> cat("Original 1 / UCDP 0:", sum(cod$degradation_original == 1 & cod$degradation_ucdp == 0),
+     "| Original 0 / UCDP 1:", sum(cod$degradation_original == 0 & cod$degradation_ucdp == 1), "\n")
Original 1 / UCDP 0: 0 | Original 0 / UCDP 1: 102 
> 
> # ---- 4. Estimation sample (validate.R specification) ----
> z_score <- function(x) (x - mean(x, na.rm = TRUE)) / sd(x, na.rm = TRUE)
> d <- aud |>
+   drop_na(eii_score, degradation, vdem_electoral, friction, resource_density,
+           gdp_pc_log, fiscal_pressure) |>
+   mutate(eii_score = as.integer(eii_score),
+          friction_z = z_score(friction), resource_density_z = z_score(resource_density),
+          fiscal_pressure_z = z_score(fiscal_pressure), gdp_pc_log_z = z_score(gdp_pc_log),
+          trend_z = z_score(trend), regime_z = z_score(vdem_electoral),
+          fric_x_fiscal = friction_z * fiscal_pressure_z)
> stopifnot(nrow(d) == 538)
> 
> mis <- d |> filter(degradation_original != degradation)
> cat("\nEstimation sample: rows where the original column disagreed:", nrow(mis), "of", nrow(d), "\n")

Estimation sample: rows where the original column disagreed: 54 of 538 
> print(mis |> group_by(country) |>
+         summarize(years = paste0(min(year), "-", max(year)), n = n(),
+                   original = first(degradation_original), ucdp = first(degradation),
+                   mean_eii = round(mean(eii_score), 1), .groups = "drop") |>
+         as.data.frame(), row.names = FALSE)
      country     years  n original ucdp mean_eii
  Afghanistan 2002-2021 20        0    1    179.3
        Haiti 1991-1991  1        0    1      4.0
         Laos 1986-1990  5        0    1      5.8
    Nicaragua 1985-1990  6        0    1      0.7
     Pakistan 2001-2021 20        0    1    256.2
       Panama 1989-1989  1        0    1      7.0
 Sierra Leone 2001-2001  1        0    1   1672.0
> 
> f_spec <- eii_score ~ resource_density_z + friction_z + degradation +
+   fiscal_pressure_z + trend_z + regime_z + gdp_pc_log_z + fric_x_fiscal |
+   regime_z + friction_z + resource_density_z + degradation + trend_z
> f_orig <- zeroinfl(f_spec, data = mutate(d, degradation = degradation_original), dist = "negbin")
> f_ucdp <- zeroinfl(f_spec, data = d, dist = "negbin")
> co <- summary(f_orig)$coefficients$count; cu <- summary(f_ucdp)$coefficients$count
> v <- rownames(co)[-1]
> cat("\nCount equation: original degradation vs UCDP-rebuilt degradation (current panel)\n")

Count equation: original degradation vs UCDP-rebuilt degradation (current panel)
> cat(sprintf("%-20s %18s %18s\n", "Variable", "Original", "UCDP rebuilt"))
Variable                       Original       UCDP rebuilt
> for (x in v) cat(sprintf("%-20s %9.3f (p=%.3f) %9.3f (p=%.3f)\n", x,
+                          co[x, 1], co[x, 4], cu[x, 1], cu[x, 4]))
resource_density_z       0.345 (p=0.064)    -0.148 (p=0.206)
friction_z              -0.403 (p=0.059)    -0.239 (p=0.250)
degradation             -1.099 (p=0.011)     0.656 (p=0.038)
fiscal_pressure_z       -1.084 (p=0.000)    -1.485 (p=0.000)
trend_z                 -0.321 (p=0.256)    -0.879 (p=0.001)
regime_z                 0.341 (p=0.119)     0.601 (p=0.002)
gdp_pc_log_z            -0.674 (p=0.000)    -0.557 (p=0.000)
fric_x_fiscal            0.072 (p=0.695)     0.203 (p=0.262)
Log(theta)              -1.682 (p=0.000)    -1.792 (p=0.000)
> 
> # ---- 5. The full pre-audit panel, reconstructed from the log ----
> # Reverting every logged cell recreates the panel as it stood before the
> # 2026-10-17 audit; fitting it gives the estimates on that panel.
> log_all <- read_csv(here("panel_corrections.csv"), show_col_types = FALSE,
+                     col_types = cols(.default = col_character()))
> orig <- df
> for (k in seq_len(nrow(log_all))) {
+   r <- log_all[k, ]
+   i <- which(orig$iso3 == r$iso3 & orig$year == as.integer(r$year))
+   orig[[r$variable]][i] <- suppressWarnings(as.numeric(r$old))
+ }
> d0 <- orig |>
+   drop_na(eii_score, degradation, vdem_electoral, friction, resource_density,
+           gdp_pc_log, fiscal_pressure) |>
+   mutate(eii_score = as.integer(eii_score),
+          friction_z = z_score(friction), resource_density_z = z_score(resource_density),
+          fiscal_pressure_z = z_score(fiscal_pressure), gdp_pc_log_z = z_score(gdp_pc_log),
+          trend_z = z_score(trend), regime_z = z_score(vdem_electoral),
+          fric_x_fiscal = friction_z * fiscal_pressure_z)
> f_pre <- zeroinfl(f_spec, data = d0, dist = "negbin")
> cpre <- summary(f_pre)$coefficients$count
> cat("\nPre-audit panel (all logged changes reverted): N =", nrow(d0), "\n")

Pre-audit panel (all logged changes reverted): N = 535 
> cat(sprintf("%-20s %18s %18s\n", "Variable", "Pre-audit panel", "Current panel"))
Variable                Pre-audit panel      Current panel

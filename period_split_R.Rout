> # ---- The comparison ----
> pull_coef <- function(f, v) {
+   if (is.null(f)) return(rep(NA_real_, 3))
+   s <- summary(f)$coefficients$count
+   if (!v %in% rownames(s)) return(rep(NA_real_, 3))
+   c(s[v, "Estimate"], s[v, "Std. Error"], s[v, "Pr(>|z|)"])
+ }

> # ---- Highest density interval ----
> # The shortest interval containing prob% of the posterior mass.
> # Unlike a quantile interval (equal tails), the HDI can be asymmetric.
> hdi <- function(x, prob = 0.95) {
+   x <- sort(x)
+   n <- length(x)
+   k <- floor(prob * n)
+   widths <- x[(k + 1):n] - x[1:(n - k)]
+   i <- which.min(widths)
+   c(x[i], x[i + k])
+ }

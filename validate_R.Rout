> # ------------------------------------------------------------------
> # 6. SIGN STABILITY OF THE PRIMARY ESTIMATES
> # ------------------------------------------------------------------
> # Signs on the primary specification that hold under all three regime
> # measures (V-Dem electoral, V-Dem clean elections, Polity2) on the
> # corrected panel. If any flips, something fundamental has changed.
> cat("\n[7] SUBSTANTIVE FINDINGS — SIGN STABILITY\n")

[7] SUBSTANTIVE FINDINGS — SIGN STABILITY
> expect_neg <- c("fiscal_pressure_z", "gdp_pc_log_z", "trend_z", "friction_z")

# Fitted models -- large; reproducible from the scripts with seed 42
*.rds

# Local tool and session files: never commit
.claude.json
.python_history
.Rhistory
.RData
.Rproj.user/

# Temporary files
*.tmp
*.bak
*.lock

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
__pycache__/

# EII v2 raw source snapshots: fetched and verified by v2/build/fetch_sources.R
# (GSDB is released by request and is not redistributed)
v2/sources/raw/

# Archives and by-request data dropped next to the sources by hand: never commit
# (GSDB's terms forbid redistribution; the raw bundle contains GSDB files)
v2/sources/*.zip
v2/sources/*.tar.gz
v2/sources/*.tgz
**/GSDB*

# Build outputs drawn from third-party data whose terms restrict reproduction
# (Energy Institute yearly production): rebuilt locally, never committed
v2/output/local/
